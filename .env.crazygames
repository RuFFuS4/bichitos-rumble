# The CrazyGames build (vite build --mode crazygames; see
# scripts/build-crazygames.mjs and docs/H5_CRAZYGAMES.md). Public values only.
#
# No online and no Sentry in this build (Rafa, 2026-09-29): both are
# declared EMPTY on purpose, so a .env or .env.local on the machine cannot
# slip them in. Variables already set in the shell would still win over
# this file; build-crazygames.mjs clears them and checks the bundle.
VITE_PLATFORM=crazygames
VITE_PORTAL=off
VITE_SERVER_URL=
VITE_SENTRY_DSN=
